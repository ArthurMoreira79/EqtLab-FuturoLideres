# Copie para .env.local. Sem IA configurada, ela roda em modo simulado.

# Banco: suba com `docker compose up -d` na raiz do repositório.
DATABASE_URL=postgresql://futuro:futuro_dev@localhost:5434/futuro_lideres

# Segredo que assina o JWT da sessão (mínimo 32 caracteres). Gere um com:
#   openssl rand -base64 48
# Em produção é obrigatório; em desenvolvimento, sem ele, usa-se um segredo fixo (inseguro).
JWT_SECRET=

# IA: "simulado" (padrão) ou "compativel-openai"
IA_PROVEDOR=simulado
# IA_BASE_URL=https://api.openai.com/v1
# IA_API_KEY=
# IA_MODELO=

# Chat da Clara: configure apenas no servidor, nunca com NEXT_PUBLIC_.
# Independente de IA_PROVEDOR (avaliações/relatórios).
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash

# D-ID: geração única do vídeo de boas-vindas (pnpm clara:video).
# Chave Basic do painel D-ID; nunca use NEXT_PUBLIC_ para esta credencial.
DID_API_KEY=
# DID_VOICE_ID=pt-BR-FranciscaNeural
# DID_TALK_ID=tlk_...  # retomar uma geração pendente sem criar outra
